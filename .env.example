# Root/server local env template
# - Yelp variables are used by scripts/find-yelp.js and scripts/yelp-find-business.js
# - Resend variables are required by server routes when running the Node backend

# Server
PORT=3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESERVATION_TO_EMAIL=
PRINT_PORTAL_TO_EMAIL=

# Yelp helper scripts
YELP_API_KEY=
YELP_SEARCH_TERM=
YELP_SEARCH_LOCATION=
YELP_BUSINESS_ID=shipping-with-purpose-scottsdale-2
